DATABASE_URL=sqlite:///./finpilot.db
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET
TWELVE_DATA_KEY=
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Leave the key empty to use deterministic local answers and evidence mode.

# Preferred provider-neutral configuration. The LLM_API_KEY can be a free
# OpenRouter or Groq key; use an OpenAI-compatible base URL for those providers.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-8b-instruct:free

# Optional: free chat providers generally do not provide embeddings.
# Leave these empty to use lexical retrieval, or point them at an embedding API.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=huggingface
HF_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_URL=https://router.huggingface.co/hf-inference/models
