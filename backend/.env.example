DATABASE_URL=sqlite:///./finpilot.db
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET
TWELVE_DATA_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Leave the key empty to use deterministic local answers and evidence mode.

# Optional provider overrides. Leave LLM_API_KEY and LLM_BASE_URL empty to use
# OPENAI_API_KEY directly with the OpenAI API.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# OpenAI embeddings use OPENAI_API_KEY by default. Existing documents must be
# re-uploaded/re-indexed when changing embedding providers or models.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai_compatible
HF_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_URL=https://router.huggingface.co/hf-inference/models
